# config.dev.json/config.prod.json hold real Morning API secrets (see config.example.json
# for the placeholder template) and are the file the Docker containers mount. config.local.json
# is the per-clone file for `run_webapp.sh local` (local code, dependencies pointed at dev; see
# config.local.example.json).
config/config.dev.json
config/config.local.json
config/config.prod.json
# Ad hoc, per-clone: local host-mode preview of the webapp against real prod ledger data +
# real prod Morning credentials (points at the read-only sshfs mount, uses an isolated
# webapp_data_preview copy so it never touches the shared canonical webapp_data). Never used
# by provision_webapp.sh or any deploy script - config.prod.json above stays the real one.
config/config.prod-local-preview.json
test_data/
logs/
venv/
__pycache__/
*.pyc
.pytest_cache/
htmlcov/
.coverage
auth/
