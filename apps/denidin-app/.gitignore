# Python virtual environment
venv/
env/
ENV/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Configuration secrets (CRITICAL: never commit credentials)
config/config.json
config/config.yaml
# 019-env-separation: per-environment real config files (only the .example.json
# templates are committed)
config/config.dev.json
config/config.prod.json
# Feature 018: config.test.json now holds real secrets for real-API E2E tests
# (ai_api_key, mcp.morning_auth_token, and a duplicated copy of Morning sandbox
# credentials for independent test verification - never read cross-app at
# runtime). Untracked to avoid committing them, mirroring apps/morning-mcp-app's
# treatment of its own config.test.json (see that app's tasks.md T021 history).
config/config.test.json

# Application logs
logs/
*.log

# Runtime state
state/
denidin.pid

# Session and memory data
data/sessions/
data/memory/
data/media/
data/events/

# Test data (generated during tests)
test_data/

# Player run configs targeting prod (real data_root/denidin_config, and a real
# phone number once filled in) - never tracked, unlike the *_test.json ones,
# which use only config.test.json's own placeholder values.
player/*_prod.json

# Throwaway tooling/state for an interactive, human-reviewed player run
# (Feature 043) - NOT part of the production player/ module. Lives in-repo
# (not /tmp) so it survives across sessions instead of getting silently wiped
# between them (2026-08-17 incident: a /tmp-based version of this lost all
# review progress and the throwaway data_root between sessions).
.player_review_scratch/

# Dev environment persistent data (019-env-separation; renamed from test_data/)
dev_data/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ephemeral session test-run logs - not project docs, shouldn't be tracked
TEST_RUN_LOG.md
UNIT_INTEGRATION_TEST_LOG.md

# OS
.DS_Store
Thumbs.db
