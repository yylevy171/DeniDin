# Secrets: real per-environment config files must never be baked into image
# layers (VOLUME ["/app/config"] overrides them at runtime anyway — only
# config.example.json, the safe placeholder template, should ship in the image).
# Any per-env / local config (config.dev/prod/test.json, config.player_prod.json, ...).
config/config.*.json
!config/config.example.json
# The plain, gitignored local config/config.json too - `config.*.json` doesn't match it, so a
# clone's own copy (real OpenAI/Green API/MCP secrets) was baked into every release image
# (found 2026-10-06 in denidin-app 0.7.9 and 0.8.0).
config/config.json

# Other gitignored local files that `COPY . .` would otherwise bake in: real prod client
# media, generated test outputs, root-level generated .docx files (anchored at the context
# root - config/fee_agreement_templates/ is unaffected), type-check cache.
media_from_prod/
test_results/
tests/test_results/
*.docx
.mypy_cache/
**/.DS_Store
**/*.log
**/*.log.*

# Runtime data/logs — also volume-mounted, never needed in the image itself.
dev_data/
data/
logs/
test_data/
player_data/

# Local dev/VCS cruft.
.git/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
htmlcov/
.coverage
