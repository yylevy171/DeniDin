# Secrets: real per-environment config files must never be baked into image
# layers (VOLUME ["/app/config"] overrides them at runtime anyway — only
# config.example.json, the safe placeholder template, should ship in the image).
# Any per-env / local config (config.dev/prod/test.json, config.player_prod.json, ...).
config/config.*.json
!config/config.example.json
**/.DS_Store
**/*.log
**/*.log.*

# Runtime data/logs — also volume-mounted, never needed in the image itself.
dev_data/
data/
logs/
test_data/
player_data/

# Local dev/VCS cruft.
.git/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
htmlcov/
.coverage
