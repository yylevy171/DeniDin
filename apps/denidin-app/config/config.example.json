{
  "green_api_instance_id": "YOUR_GREEN_API_INSTANCE_ID",
  "green_api_token": "YOUR_GREEN_API_TOKEN",
  "ai_api_key": "YOUR_OPENAI_API_KEY",
  "ai_model": "gpt-4o-mini",
  "ai_vision_model": "gpt-4o-mini",
  "ai_embedding_model": "text-embedding-3-large",
  "ai_reply_max_tokens": 1000,
  "temperature": 0.7,
  "log_level": "INFO",
  "poll_interval_seconds": 5,
  "max_retries": 3,
  "data_root": "data",
  "feature_flags": {
    "enable_memory_system": false,
    "enable_rbac": false
  },
  "godfather_phone": "YOUR_GODFATHER_WHATSAPP_ID",
  "memory": {
    "session": {
      "storage_dir": "data/sessions",
      "max_tokens_by_role": {
        "client": 4000,
        "godfather": 100000
      },
      "session_timeout_hours": 24
    },
    "longterm": {
      "enabled": true,
      "storage_dir": "data/memory",
      "collection_name": "godfather_memory",
      "top_k_results": 5,
      "min_similarity": 0.15
    }
  },
  "constitution_config": {
    "file": "runtime_constitution.md"
  },
  "mcp": {
    "morning_auth_token": "MUST_MATCH_MORNING_APP_MCP_AUTH_TOKEN",
    "morning_status_file": "data/morning_mcp_status.json",
    "morning_server_label": "morning-invoices",
    "url_max_age_seconds": 0
  },
  "user_roles": {
    "godfather": {
      "max_tokens": 100000,
      "can_access_memory": true,
      "max_context_memories": 10
    },
    "client": {
      "max_tokens": 4000,
      "can_access_memory": true,
      "max_context_memories": 3
    }
  }
}
